# Copy this file to .env. Never commit the populated file.

# Server
PORT=4000
NODE_ENV=development
# Set to production on Render. This enables safe one-hop reverse-proxy support.
CLIENT_ORIGIN=http://localhost:5173
# Optional comma-separated extra browser origins, for example https://app.example.com
CLIENT_ORIGINS=
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/ai_resume?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# AI — Gemini offers a free tier. Add a key only when Phase 2 begins.
GEMINI_API_KEY=your-free-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Abuse controls
DAILY_ANALYSIS_LIMIT=20

# Client
VITE_API_URL=http://localhost:4000/api
